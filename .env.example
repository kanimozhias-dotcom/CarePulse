# ==========================================
# CarePulse Healthcare System Environment Setup
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or Local mongod)
MONGODB_URI="mongodb://localhost:27017/carepulse_healthcare"

# JWT Secret for Session Hashing & Authorization
JWT_SECRET="carepulse_super_secret_jwt_key_2026_production"
JWT_EXPIRES_IN="7d"

# Client Web Application URL
APP_URL="http://localhost:3000"

# Gemini API Key (if AI Studio API features are enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional External SMTP Email Gateway (if configured; if empty, system uses in-app notification center)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@carepulse.hospital"
